{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "noderings.cloud",
      "initial-version": "0.1.0",
      "include-v-in-tag": false,
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "skip-changelog": true,
      "version-file": "version.txt",
      "extra-files": [
        {
          "type": "generic",
          "path": "galaxy.yml"
        }
      ],
      "pull-request-title-pattern": "chore: release ${version}",
      "pull-request-header": "Merging this pull request tags the release and publishes `noderings.cloud` to Ansible Galaxy. The release-please workflow adds a commit that runs `antsibull-changelog release`, turning `changelogs/fragments` into `CHANGELOG.rst`.",
      "changelog-sections": [
        {"type": "feat", "section": "Features"},
        {"type": "fix", "section": "Bug fixes"},
        {"type": "perf", "section": "Performance"},
        {"type": "deps", "section": "Dependencies"},
        {"type": "revert", "section": "Reverts"},
        {"type": "docs", "section": "Documentation"},
        {"type": "ci", "section": "CI", "hidden": true},
        {"type": "chore", "section": "Miscellaneous", "hidden": true},
        {"type": "test", "section": "Tests", "hidden": true}
      ]
    }
  }
}
